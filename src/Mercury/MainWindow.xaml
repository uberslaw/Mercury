<Window x:Class="Mercury.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mercury"
        Title="Mercury"
        Height="780" Width="1080"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="BgBrush">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Help">
                <MenuItem Header="_How to use Mercury" Click="HelpMenu_Click"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="StatusBarBrush,StatusBarTextBrush">
            <StatusBar>
                <StatusBarItem>
                    <TextBlock Text="{Binding DataPathLabel}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusBarTextBrush}"/>
                </StatusBarItem>
            </StatusBar>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="HeaderBrush">
            <Border Background="{DynamicResource HeaderBrush}" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="OnHeaderBrush,Body">
                        <TextBlock Text="Progress" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource OnHeaderBrush}"
                                   FontFamily="{DynamicResource BodyFontFamily}" FontSize="{DynamicResource BodyFontSize}"/>
                    </Border>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="OnHeaderBrush,Body">
                        <TextBlock Text="Current" FontWeight="SemiBold" Margin="0,0,0,4" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource OnHeaderBrush}"
                                   FontFamily="{DynamicResource BodyFontFamily}" FontSize="{DynamicResource BodyFontSize}"/>
                    </Border>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="HeaderBarFillBrush,HeaderBarTrackBrush">
                        <ProgressBar Value="{Binding JobPercent, Mode=OneWay}" Maximum="100"
                                     Foreground="{DynamicResource HeaderBarFillBrush}"
                                     Background="{DynamicResource HeaderBarTrackBrush}"/>
                    </Border>
                    <StackPanel Visibility="{Binding ShowOverallProgress, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="OnHeaderBrush,Body">
                            <TextBlock Text="Overall" FontWeight="SemiBold" Margin="0,8,0,4" HorizontalAlignment="Left"
                                       Foreground="{DynamicResource OnHeaderBrush}"
                                       FontFamily="{DynamicResource BodyFontFamily}" FontSize="{DynamicResource BodyFontSize}"/>
                        </Border>
                        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="HeaderBarFillBrush,HeaderBarTrackBrush">
                            <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100"
                                         Foreground="{DynamicResource HeaderBarFillBrush}"
                                         Background="{DynamicResource HeaderBarTrackBrush}"/>
                        </Border>
                    </StackPanel>
                    <local:ProgressStatsLine DataContext="{Binding HeaderStats}" Foreground="{DynamicResource OnHeaderBrush}"/>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="OkBrush,DangerBrush">
                        <TextBlock Text="{Binding ResultBanner}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </Border>
                    <local:TransferRundownBlock DataContext="{Binding HeaderRundown}" Foreground="{DynamicResource OnHeaderBrush}"/>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="WarnBrush">
                        <TextBlock Text="This destination looks like a cloud-synced folder. Mercury verifies the local copy, not the cloud upload."
                                   Foreground="{DynamicResource WarnBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding CloudWarning, Converter={StaticResource BoolToVis}}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="PanelBrush,TabBackgroundBrush,TabSelectedBackgroundBrush,TabSelectedForegroundBrush,TabUnselectedForegroundBrush,Body">
        <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Transfer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="BorderBrush">
                        <GroupBox Header="Paths">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Source" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Margin="0,0,8,8" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="InputBackgroundBrush">
                                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                 AllowDrop="True" PreviewDragOver="Path_PreviewDragOver" Drop="Source_Drop"
                                                 ToolTip="File, folder, or drive — anything Explorer can open."/>
                                    </Border>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource ToolbarButton}" Command="{Binding BrowseSourceCommand}" Margin="0,0,0,8"/>
                                </Grid>
                                <ComboBox Margin="90,0,88,8"
                                          ItemsSource="{Binding RecentSources}"
                                          SelectedItem="{Binding PickedRecentSource}"
                                          Visibility="{Binding HasRecentSources, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Recent sources"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Destination" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding DestKindIndex}"
                                              ToolTip="Folder copy is unchanged. Catcher sends HTTPS to a listener on the other side of the router.">
                                        <ComboBoxItem>Folder / USB / UNC</ComboBoxItem>
                                        <ComboBoxItem>Catcher (HTTPS over network)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Grid Visibility="{Binding DestIsFolder, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Column="1" Margin="0,0,8,0"
                                             Text="{Binding DestPath, UpdateSourceTrigger=PropertyChanged}"
                                             AllowDrop="True" PreviewDragOver="Path_PreviewDragOver" Drop="Dest_Drop"/>
                                    <Button Grid.Column="2" Content="Browse" Style="{StaticResource ToolbarButton}" Command="{Binding BrowseDestCommand}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0"
                                              ItemsSource="{Binding RecentDestinations}"
                                              SelectedItem="{Binding PickedRecentDest}"
                                              Visibility="{Binding HasRecentDestinations, Converter={StaticResource BoolToVis}}"
                                              ToolTip="Recent destinations"/>
                                </Grid>

                                <StackPanel Visibility="{Binding DestIsCatcher, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Template" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="0,0,0,8"
                                                  ItemsSource="{Binding CatcherTemplates}"
                                                  SelectedItem="{Binding SelectedCatcherTemplate}"
                                                  DisplayMemberPath="Display"/>
                                        <TextBlock Grid.Row="1" Text="Passphrase" VerticalAlignment="Center"/>
                                        <PasswordBox x:Name="CatcherPassphraseBox" Grid.Row="1" Grid.Column="1"
                                                     PasswordChanged="CatcherPassphrase_PasswordChanged"/>
                                    </Grid>
                    <TextBlock Text="{Binding CatcherOnlineStatus}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding CatcherTransferHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        </Border>

                        <GroupBox Header="Job options">
                            <StackPanel>
                                <WrapPanel>
                                    <CheckBox Content="Unlimited speed" IsChecked="{Binding UnlimitedSpeed}"/>
                                    <TextBlock Text="Max MB/s" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding MaxMBpsText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UnlimitedSpeed, Converter={StaticResource InverseBool}}" Margin="0,0,16,0"
                                             ToolTip="Applies immediately to the running job."/>
                                    <CheckBox Content="Hours of operation" IsChecked="{Binding HoursEnabled}"/>
                                    <TextBox Width="70" Text="{Binding HoursStart}" ToolTip="Start (HH:mm)"/>
                                    <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBox Width="70" Text="{Binding HoursEnd}" ToolTip="End (HH:mm)"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Retries" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="50" Text="{Binding RetryCount}" Margin="0,0,16,0"/>
                                    <TextBlock Text="Wait (sec)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="50" Text="{Binding RetryWait}" Margin="0,0,16,0"/>
                                    <TextBlock Text="Overwrite" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="240" SelectedIndex="{Binding OverwriteIndex}">
                                        <ComboBoxItem>Skip if dest is newer or equal</ComboBoxItem>
                                        <ComboBoxItem>Always overwrite</ComboBoxItem>
                                        <ComboBoxItem>Never if dest exists</ComboBoxItem>
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <TextBlock Text="Verify" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="200" SelectedIndex="{Binding VerifyIndex}" Margin="0,0,16,0">
                                        <ComboBoxItem>Quick (size + time)</ComboBoxItem>
                                        <ComboBoxItem>Thorough (xxHash64)</ComboBoxItem>
                                    </ComboBox>
                                    <CheckBox Content="Dry run (enumerate only)" IsChecked="{Binding DryRun}"/>
                                    <CheckBox Content="Pack as zip (faster on USB / many small files)" IsChecked="{Binding PackAsZip}"
                                              Margin="16,0,0,0"
                                              ToolTip="Uses a stored (uncompressed) zip as transport so USB / many small files write as one sequential file. Already-compressed files (video, photos, audio, archives) are copied as-is. After the zip lands, Mercury unpacks it into a normal folder tree at the destination and deletes the zip. Leave off to copy files one-by-one."/>
                                    <CheckBox Content="Destination can expand" IsChecked="{Binding IgnoreFreeSpaceCheck}"
                                              Margin="16,0,0,0"
                                              ToolTip="When on, Mercury still reports Need vs available but does not abort if the destination is thin-provisioned or can grow. Leave off to keep the disk-full guard."/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Start after" IsChecked="{Binding ScheduleEnabled}"
                                              ToolTip="Calendar start. Hours of operation still apply if enabled."/>
                                    <DatePicker SelectedDate="{Binding ScheduledDate}" IsEnabled="{Binding ScheduleEnabled}"
                                              Width="140" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Width="70" Text="{Binding ScheduledTime, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding ScheduleEnabled}" ToolTip="Time (HH:mm)"/>
                                    <Button Content="RoboFlags" Style="{StaticResource CompactButton}"
                                            Command="{Binding ToggleRoboFlagsCommand}"
                                            Margin="16,0,0,0"
                                            ToolTip="Robocopy-equivalent copy checkboxes for the native Mercury copier (not robocopy.exe)."/>
                                </WrapPanel>
                                <Border Visibility="{Binding RoboFlagsExpanded, Converter={StaticResource BoolToVis}}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        Padding="10,8" Margin="0,8,0,0" CornerRadius="4"
                                        Background="{DynamicResource PanelAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Native copy flags (hover for the robocopy cousin). Defaults keep creation time, last-write, attributes, directory times, and empty folders."
                                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <CheckBox Content="Timestamps" IsChecked="{Binding CopyTimestamps}" Width="200"
                                                      ToolTip="/COPY:T — copy source creation time and last-write to dest. Default on. Windows copy otherwise sets dest CreationTime to now."/>
                                            <CheckBox Content="Attributes" IsChecked="{Binding CopyAttributes}" Width="200"
                                                      ToolTip="/COPY:A — copy file attributes (read-only, hidden, archive, …). Default on."/>
                                            <CheckBox Content="NTFS ACL / security" IsChecked="{Binding CopySecurity}" Width="200"
                                                      ToolTip="/COPY:S / /SEC — copy NTFS DACL. Default off. Fail-soft + log if denied."/>
                                            <CheckBox Content="Owner" IsChecked="{Binding CopyOwner}" Width="200"
                                                      ToolTip="/COPY:O — copy owner. Default off. May need elevation; fail-soft + log."/>
                                            <CheckBox Content="Directory timestamps" IsChecked="{Binding CopyDirectoryTimestamps}" Width="200"
                                                      ToolTip="/DCOPY:T — copy folder creation and last-write times. Default on with file timestamps."/>
                                            <CheckBox Content="Empty directories" IsChecked="{Binding CopyEmptyDirectories}" Width="200"
                                                      ToolTip="/E — create empty source folders at dest (vs /S). Default on."/>
                                            <CheckBox Content="Unbuffered I/O" IsChecked="{Binding UnbufferedIo}" Width="200"
                                                      ToolTip="/J — write-through FileStream (cousin of unbuffered I/O). Default off. Useful for large video."/>
                                            <CheckBox Content="Copy symbolic links as links" IsChecked="{Binding CopySymbolicLinksAsLinks}" Width="200"
                                                      ToolTip="/SL — copy symlinks as links. Default off: skip reparse points (do not follow), same as today."/>
                                            <CheckBox Content="FAT 2s times" IsChecked="{Binding FatTimestampTolerance}" Width="200"
                                                      ToolTip="/FFT — treat timestamps within 2 seconds as equal (FAT). Default off. Turn on for FAT dest."/>
                                            <CheckBox Content="Exclude hidden/system" IsChecked="{Binding ExcludeHiddenSystem}" Width="200"
                                                      ToolTip="/XA:HS — skip hidden and system files and folders. Default off."/>
                                            <CheckBox Content="Purge extra dest files" IsChecked="{Binding PurgeExtraDestFiles}" Width="200"
                                                      ToolTip="/PURGE — delete dest files and folders that are not in the source. Default off. Destructive; confirms before start."/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Global bandwidth (all jobs)">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="Min MB/s" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding GlobalMinText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"
                                             ToolTip="Do not throttle the aggregate below this when work is available. Applies immediately."/>
                                    <CheckBox Content="Unlimited max" IsChecked="{Binding GlobalMaxUnlimited}"/>
                                    <TextBlock Text="Max MB/s" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Width="80" Text="{Binding GlobalMaxText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding GlobalMaxUnlimited, Converter={StaticResource InverseBool}}"
                                             ToolTip="Applies immediately to running jobs."/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox Content="Throttle to" IsChecked="{Binding IdleThrottleEnabled}"
                                              ToolTip="When the PC is in use, cap all jobs to this speed. Idle uses Unlimited / Max MB/s. Applies immediately."/>
                                    <TextBox Width="80" Text="{Binding IdleThrottleText, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IdleThrottleEnabled}" Margin="8,0,8,0"
                                             ToolTip="MB/s while CPU from other programs is above about 18% (Mercury’s own copy is excluded when possible)."/>
                                    <TextBlock Text="MB/s when not idle" VerticalAlignment="Center"
                                               ToolTip="Applies to every job on this PC. Leave off to use only Unlimited / Max MB/s."/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Button" Margin="0,4,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="AccentBrush,AccentForegroundBrush">
                                <Button Content="Start" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}"/>
                            </Border>
                            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ButtonBrush,ButtonForegroundBrush">
                                <Button Content="Add to queue" Style="{StaticResource ToolbarButton}" Command="{Binding AddToQueueCommand}"/>
                            </Border>
                            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ButtonHoverBrush">
                                <Button Content="Pause" Style="{StaticResource ToolbarButton}" Command="{Binding PauseCommand}"/>
                            </Border>
                            <Button Content="{Binding PauseAfterThisFileLabel}" Style="{StaticResource ToolbarButton}"
                                    Command="{Binding PauseAfterThisFileCommand}"
                                    ToolTip="{Binding PauseAfterThisFileToolTip}"/>
                            <Button Content="Resume" Style="{StaticResource ToolbarButton}" Command="{Binding ResumePausedCommand}"/>
                            <Button Content="Pause all" Style="{StaticResource ToolbarButton}" Command="{Binding PauseAllCommand}"/>
                            <Button Content="Resume all" Style="{StaticResource ToolbarButton}" Command="{Binding ResumeAllCommand}"/>
                            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="CancelButtonBrush,AccentForegroundBrush">
                                <Button Content="Stop" Style="{StaticResource CancelButton}" Command="{Binding StopCommand}"/>
                            </Border>
                            <Button Content="Resume last" Style="{StaticResource ToolbarButton}" Command="{Binding ResumeLastCommand}"/>
                            <Button Content="Save job" Style="{StaticResource CompactButton}" Command="{Binding SaveJobCommand}"/>
                        </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CurrentFile}" Margin="0,4,0,0" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <local:TransferRundownBlock DataContext="{Binding Rundown}"/>

                        <GroupBox Header="Saved jobs" Margin="0,16,0,0" Visibility="{Binding HasSavedJobs, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="PanelAltBrush">
                            <ListBox ItemsSource="{Binding SavedJobs}" FontFamily="Segoe UI" FontSize="13" MaxHeight="140">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource CompactButton}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DeleteSavedJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button DockPanel.Dock="Right" Content="Load" Style="{StaticResource CompactButton}"
                                                    Command="{Binding DataContext.LoadSavedJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Border>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Queue">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Pause all" Style="{StaticResource ToolbarButton}" Command="{Binding PauseAllCommand}"/>
                            <Button Content="Resume all" Style="{StaticResource ToolbarButton}" Command="{Binding ResumeAllCommand}" Margin="0"/>
                        </StackPanel>
                        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="MutedBrush">
                            <TextBlock Text="Queued, running, and finished jobs" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                    </DockPanel>
                    <GroupBox DockPanel.Dock="Bottom" Header="Selected job" Visibility="{Binding HasSelectedQueueJob, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedQueueJob.SettingsSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <CheckBox Content="Unlimited speed" IsChecked="{Binding SelectedQueueJob.UnlimitedSpeed}"
                                          IsEnabled="{Binding SelectedQueueJob.CanEditSpeed}"
                                          ToolTip="Applies immediately if this job is running."/>
                                <TextBlock Text="Max MB/s" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="80"
                                         Text="{Binding SelectedQueueJob.MaxMBpsText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding SelectedQueueJob.CanEditLimitedSpeed}"/>
                            </WrapPanel>
                            <local:TransferRundownBlock DataContext="{Binding SelectedQueueJob.Rundown}"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock DockPanel.Dock="Top" Text="No jobs in the queue." Opacity="0.7" Margin="0,8,0,8"
                               Visibility="{Binding HasQueueJobs, Converter={StaticResource InverseBoolToVis}}"/>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="QueueBackgroundBrush"
                            Visibility="{Binding HasQueueJobs, Converter={StaticResource BoolToVis}}">
                    <ListBox x:Name="QueueList"
                             ItemsSource="{Binding QueueJobs}"
                             SelectedItem="{Binding SelectedQueueJob}"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Background="{DynamicResource QueueBackgroundBrush}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="Visible">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
                                        <Button Content="Pause" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanPause}"
                                                Command="{Binding DataContext.PauseQueueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Resume" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanResume}"
                                                Command="{Binding DataContext.ResumeQueueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Stop" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanStop}"
                                                Command="{Binding DataContext.StopQueueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding HoldLabel}" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanToggleHold}"
                                                Command="{Binding DataContext.ToggleHoldQueueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Remove" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanRemove}"
                                                Command="{Binding DataContext.RemoveQueueJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Up" Style="{StaticResource CompactButton}"
                                                IsEnabled="{Binding CanMoveUp}"
                                                Command="{Binding DataContext.MoveQueueJobUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Down" Style="{StaticResource CompactButton}" Margin="0"
                                                IsEnabled="{Binding CanMoveDown}"
                                                Command="{Binding DataContext.MoveQueueJobDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </WrapPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Route}" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding StatusLabel}" Margin="0,4,0,6"/>
                                        <ProgressBar Value="{Binding Percent}" Maximum="100" Height="14"/>
                                        <local:ProgressStatsLine DataContext="{Binding Stats}"/>
                                        <TextBlock Text="{Binding RundownLine}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasRundown, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Ok">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Warn">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Danger">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="Console">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="200" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Text="{Binding ConsoleSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter console lines (case-insensitive)"/>
                            <CheckBox Content="Follow" IsChecked="{Binding FollowConsole}"
                                      VerticalAlignment="Center"
                                      ToolTip="When on, the console stays on the newest line. Scroll up or search to pause."/>
                            <CheckBox Content="Errors only" IsChecked="{Binding ErrorsOnly}" VerticalAlignment="Center"/>
                            <Button Content="Copy" Style="{StaticResource ToolbarButton}" Command="{Binding CopyConsoleCommand}"/>
                            <Button Content="Open logs folder" Style="{StaticResource ToolbarButton}" Command="{Binding OpenLogsCommand}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="Verbose job output" VerticalAlignment="Center" Opacity="0.8"/>
                    </DockPanel>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ConsoleBackgroundBrush,ErrorLineBrush,Console">
                    <ListBox x:Name="ConsoleList"
                             ItemsSource="{Binding ConsoleView}"
                             Background="{DynamicResource ConsoleBackgroundBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorLineBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="History">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="MutedBrush">
                        <TextBlock Text="Past transfers, newest first. Click a row to restore its rundown."
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <GroupBox DockPanel.Dock="Bottom" Header="Selected transfer" Visibility="{Binding HasSelectedHistoryItem, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedHistoryItem.Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <local:TransferRundownBlock DataContext="{Binding SelectedHistoryItem.Rundown}"/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock DockPanel.Dock="Top" Text="No transfers recorded yet." Opacity="0.7" Margin="0,8,0,8"
                               Visibility="{Binding HasHistoryItems, Converter={StaticResource InverseBoolToVis}}"/>
                    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="QueueBackgroundBrush"
                            Visibility="{Binding HasHistoryItems, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding HistoryItems}"
                             SelectedItem="{Binding SelectedHistoryItem}"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Background="{DynamicResource QueueBackgroundBrush}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Route}" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding StatusLabel}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rundown.Highlight}" Value="Danger">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Border>
                </DockPanel>
            </TabItem>
            <TabItem Header="Network">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Create a Catcher template, export a .mercury-catch file, and copy that file to the receiving PC. Run MercuryCatcher.exe there, import, and Listen. Then choose Destination: Catcher on this Transfer tab and Start. Sender connects outbound; Catcher must already be listening. v1 sends one zip pack (or a single file); Catcher unpacks the zip into a folder tree. Per-file HTTPS resume is not in this version."/>
                        <GroupBox Header="Templates">
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding CatcherTemplates}"
                                          SelectedItem="{Binding SelectedCatcherTemplate}"
                                          DisplayMemberPath="Display"
                                          Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="Export file" Style="{StaticResource ToolbarButton}" Command="{Binding ExportCatcherCommand}"/>
                                    <Button Content="Import file" Style="{StaticResource ToolbarButton}" Command="{Binding ImportCatcherCommand}"/>
                                    <Button Content="Delete" Style="{StaticResource ToolbarButton}" Command="{Binding DeleteCatcherCommand}" Margin="0"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="New or selected template">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding NetworkName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="Public host / IP" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                         Text="{Binding NetworkPublicHost, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="WAN IP or hostname the sender will connect to. Do not leave this as this PC's loopback unless both apps are on the same machine."/>
                                <TextBlock Grid.Row="2" Text="Public port" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NetworkPublicPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="WAN port on the router (default 443). Firewalls see HTTPS/TLS."/>
                                <TextBlock Grid.Row="3" Text="Internal listen port" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NetworkInternalPort, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Port Catcher binds on the LAN. Default 8443 so you usually do not need admin. Router forwards public port here."/>
                                <TextBlock Grid.Row="4" Text="Bind IP (optional)" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NetworkBindAddress, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to listen on all interfaces (required for typical NAT). 127.0.0.1 only works on this PC."/>
                                <TextBlock Grid.Row="5" Text="Passphrase" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="NetworkPassphraseBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                                             PasswordChanged="CatcherPassphrase_PasswordChanged"/>
                                <TextBlock Grid.Row="6" Text="TLS fingerprint" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Text="{Binding NetworkFingerprint}" IsReadOnly="True"
                                         ToolTip="SHA-256 of the self-signed certificate. Sender pins this; a mismatch is treated as a possible MITM."/>
                                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding NetworkHint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </GroupBox>
                        <WrapPanel>
                            <Button Content="Create template" Style="{StaticResource AccentButton}" Command="{Binding CreateCatcherCommand}"/>
                        </WrapPanel>
                        <TextBlock Margin="0,12,0,0" Text="{Binding NetworkStatus}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ThemeTab" Header="Theme">
                <local:ThemePanel DataContext="{Binding Theme}"/>
            </TabItem>
            <TabItem Header="Settings">
                <DockPanel Margin="12">
                    <GroupBox Header="Data location" DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock Text="{Binding DataRootSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <CheckBox Content="Portable: keep data beside Mercury.exe"
                                      IsChecked="{Binding PortableData}"
                                      ToolTip="Off (default) uses %APPDATA%\Mercury so logs and journals survive swapping the exe. Takes effect the next time you start Mercury."/>
                        </StackPanel>
                    </GroupBox>
                    <TextBlock DockPanel.Dock="Top" Text="Every file and folder Mercury writes. Open folder to show it in Explorer."
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ListBox ItemsSource="{Binding DataPaths}" FontFamily="Segoe UI" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Open folder" Style="{StaticResource CompactButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenFolderCommand}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding FullPath}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HelpTab" Header="Help">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding HelpSearch, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding HelpSections}" FontFamily="Segoe UI" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,12">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
        </Border>
    </DockPanel>
    </Border>
</Window>
