<Window x:Class="Mercury.NameNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name notes"
        Width="720" Height="480"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource AccentButton}" IsCancel="True" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource MutedBrush}"/>
        <ListBox x:Name="NotesList"/>
    </DockPanel>
</Window>
