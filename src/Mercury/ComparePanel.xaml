<UserControl x:Class="Mercury.ComparePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercury">
    <UserControl.Resources>
        <Style x:Key="CompareDiffText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMissingOnDest}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CompareMissingOnDestBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDestOnly}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CompareDestOnlyBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"
                   Text="Compare two folders. Compare is a queue job on its own lane, so it can run, pause, and resume while a transfer is copying. Stopping one does not stop the other. Source is the catch-up origin; Destination is the other tree. Missing-on-dest is red; dest-only is purple. Default is a recursive count. Advanced adds size, time, name, and per-folder file counts; hash (xxHash64) stays off unless you tick it."/>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="96"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Source" Style="{StaticResource OptionsLabel}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="InputBackgroundBrush"
                    Margin="0,0,0,8">
                <ComboBox Style="{StaticResource PathComboBox}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          local:ComboBoxFit.PreserveText="True"
                          HorizontalContentAlignment="Left"
                          Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding LeftRecents}"
                          IsEnabled="{Binding PathsEditable}"
                          ToolTip="Type, paste (including UNC), or pick a recent Source folder."/>
            </Border>
            <Button Grid.Column="2" Content="Browse" Style="{StaticResource PathActionButton}" Margin="8,0,0,8"
                    Command="{Binding BrowseLeftCommand}"
                    ToolTip="Pick the Source folder. UNC paths can be pasted in the box."/>

            <TextBlock Grid.Row="1" Text="Destination" Style="{StaticResource OptionsLabel}" VerticalAlignment="Center"/>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="InputBackgroundBrush"
                    Margin="0,0,0,8">
                <ComboBox Style="{StaticResource PathComboBox}"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          local:ComboBoxFit.PreserveText="True"
                          HorizontalContentAlignment="Left"
                          Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding RightRecents}"
                          IsEnabled="{Binding PathsEditable}"
                          ToolTip="Type, paste (including UNC), or pick a recent Destination folder."/>
            </Border>
            <Button Grid.Row="1" Grid.Column="2" Content="Browse" Style="{StaticResource PathActionButton}" Margin="8,0,0,8"
                    Command="{Binding BrowseRightCommand}"
                    ToolTip="Pick the Destination folder. UNC paths can be pasted in the box."/>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Advanced scan"
                      IsChecked="{Binding Advanced}"
                      ToolTip="Also compare size, last-write time, name casing, and files per folder. Hash stays off until you tick it."/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="FAT 2s times"
                      IsChecked="{Binding FatTimestampTolerance}"
                      IsEnabled="{Binding ShowAdvancedOptions}"
                      ToolTip="Same 2-second timestamp tolerance as RoboFlags → FAT 2s times. Off by default."/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Hash (xxHash64)"
                      IsChecked="{Binding HashFiles}"
                      IsEnabled="{Binding ShowAdvancedOptions}"
                      ToolTip="Expensive. Off unless ticked. Reuses Thorough verify’s xxHash64. Hashes source and destination."/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Hash source for Compare"
                      IsChecked="{Binding HashSourceForCompare}"
                      ToolTip="Off by default. This compare writes the file list and source hashes into its manifest, and keeps running if a transfer is copying. If Hash is also on, destination hashes still run. Pause or Stop keeps the hashes already written."/>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="Include in summary, highlights, list, and TXT" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Folder counts" IsChecked="{Binding FilterFolders}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="File counts" IsChecked="{Binding FilterFiles}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Size" IsChecked="{Binding FilterSize}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Timestamp" IsChecked="{Binding FilterTimestamp}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Hash" IsChecked="{Binding FilterHash}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Name" IsChecked="{Binding FilterName}"/>
            <CheckBox Style="{StaticResource OptionsCheckBox}" Content="Files per folder" IsChecked="{Binding FilterPerFolder}"/>
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Button" Margin="0,0,0,8">
            <WrapPanel>
                <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ButtonBrush,ButtonForegroundBrush">
                    <Button Content="Compare" Style="{StaticResource ToolbarButton}" Command="{Binding CompareCommand}"/>
                </Border>
                <Button Content="Pause" Style="{StaticResource CompactButton}" Command="{Binding PauseCommand}"/>
                <Button Content="Resume" Style="{StaticResource CompactButton}" Command="{Binding ResumeCommand}"/>
                <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="CancelButtonBrush,AccentForegroundBrush">
                    <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}"/>
                </Border>
                <Button Content="Export TXT" Style="{StaticResource CompactButton}" Command="{Binding ExportCommand}"
                        ToolTip="Save a detailed report of both trees and every enabled difference list. Destination-only items are always included."/>
            </WrapPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <ProgressBar Height="{DynamicResource HeaderProgressBarHeight}" Minimum="0"
                         Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"/>
            <TextBlock Text="{Binding FileEtaText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding FolderEtaText}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CompareEtaText}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}"
                   FontFamily="{DynamicResource ValueFontFamily}" FontSize="{DynamicResource ValueFontSize}"/>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Highlights}"
                      Visibility="{Binding HasHighlights, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource OptionBadge}" Margin="0,0,8,8" MaxWidth="360" Padding="10,6">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMissingOnDest}" Value="True">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource CompareMissingOnDestBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDestOnly}" Value="True">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource CompareDestOnlyBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border DockPanel.Dock="Top" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Button" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Style="{StaticResource OptionsLabel}" Text="Create job" VerticalAlignment="Center"/>
                <ComboBox Style="{StaticResource OptionsCombo}" local:ComboBoxFit.ToContent="True"
                          SelectedIndex="{Binding CopyDirectionIndex, Mode=TwoWay}"
                          ToolTip="Source → Dest copies missing-on-dest (catch-up). Dest → Source reverses. Contents land in the other folder (Include source folder name off).">
                    <ComboBoxItem>Source → Dest</ComboBoxItem>
                    <ComboBoxItem>Dest → Source</ComboBoxItem>
                </ComboBox>
                <Button Content="Add missing to queue" Style="{StaticResource ToolbarButton}"
                        Command="{Binding CreateJobCommand}"
                        ToolTip="Enumeration will skip files that already match dest. Adds a catch-up copy to the Queue without starting it (overwrite: skip if dest newer or equal)."/>
            </WrapPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="True">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource OptionsCheckBox}" Margin="12,0,0,0"
                      Content="Show destination-only"
                      IsChecked="{Binding ShowDestOnly}"
                      ToolTip="Files and folders that exist on Destination but not on Source (purple). Off hides them from the list and cards. Summary counts and TXT export still include them."/>
            <TextBlock Text="{Binding ListCaption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="PanelAltBrush">
            <ListBox ItemsSource="{Binding ListedDifferences}"
                     FontFamily="{DynamicResource BodyFontFamily}" FontSize="{DynamicResource BodyFontSize}"
                     Background="{DynamicResource PanelAltBrush}"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding ListText}" Style="{StaticResource CompareDiffText}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ListText}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
