<Window x:Class="Mercury.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        MinHeight="160">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource ToolbarButton}"
                    IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button x:Name="SecondaryButton" Content="Close now" Style="{StaticResource CancelButton}"
                    Click="Secondary_Click" Margin="0,0,8,0"/>
            <Button x:Name="PrimaryButton" Content="Wait for this file" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Primary_Click" Margin="0"/>
        </StackPanel>
        <TextBlock x:Name="BodyText" TextWrapping="Wrap"/>
    </DockPanel>
</Window>
