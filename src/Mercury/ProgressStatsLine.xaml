<UserControl x:Class="Mercury.ProgressStatsLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercury"
             Foreground="{DynamicResource TextBrush}">
    <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Progress">
        <Grid x:Name="StatsGrid" Grid.IsSharedSizeScope="True" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Four equal columns match the stats UniformGrid. Column 1 is the Speed column
                 on a single-job copy (Bytes | Speed). Copy mode uses that column boundary,
                 never the measured width of Speed, Bytes, or the file name. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" ItemsSource="{Binding GridCells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:StatPairText Margin="0,0,10,2"
                                            KeySizeGroup="{Binding KeySizeGroup}"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:ProgressStatsLine}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="CopyModeChecks"
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">
                <StackPanel.Resources>
                    <Style x:Key="HeaderCopyCheck" TargetType="CheckBox" BasedOn="{StaticResource OptionsCheckBox}">
                        <Setter Property="FontFamily" Value="{DynamicResource ProgressFontFamily}"/>
                        <Setter Property="FontSize" Value="{DynamicResource ProgressFontSize}"/>
                        <Setter Property="Foreground" Value="{DynamicResource OnHeaderBrush}"/>
                        <Setter Property="Margin" Value="0,0,14,0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>
                <CheckBox x:Name="CopyModeAdaptiveCheck" Style="{StaticResource HeaderCopyCheck}" Content="Adaptive"
                          ToolTip="Let Mercury test one stream, several files, and a split large file. This is the default for the next job."
                          IsChecked="{Binding DataContext.CopyModeAdaptive, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <CheckBox x:Name="CopyModeOneStreamCheck" Style="{StaticResource HeaderCopyCheck}" Content="One stream"
                          ToolTip="Force one stream for the rest of this copy. Does not change the saved Adaptive copy option."
                          IsChecked="{Binding DataContext.CopyModeOneStream, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <CheckBox x:Name="CopyModeTwoFilesCheck" Style="{StaticResource HeaderCopyCheck}" Content="2 files"
                          ToolTip="Copy two files at once for the rest of this copy."
                          IsChecked="{Binding DataContext.CopyModeTwoFiles, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <CheckBox x:Name="CopyModeFourFilesCheck" Style="{StaticResource HeaderCopyCheck}" Content="4 files"
                          ToolTip="Copy four files at once for the rest of this copy."
                          IsChecked="{Binding DataContext.CopyModeFourFiles, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <CheckBox x:Name="CopyModeEightFilesCheck" Style="{StaticResource HeaderCopyCheck}" Content="8 files"
                          ToolTip="Copy eight files at once for the rest of this copy. Adaptive probing does not test this width."
                          IsChecked="{Binding DataContext.CopyModeEightFiles, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <CheckBox x:Name="CopyModeTwoRangesCheck" Style="{StaticResource HeaderCopyCheck}" Content="2 ranges"
                          ToolTip="Split a large file into two ranges. A file that is too small to split stays on one stream."
                          IsChecked="{Binding DataContext.CopyModeTwoRanges, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                <TextBlock Text="At once" VerticalAlignment="Center" Margin="2,0,6,0"
                           FontFamily="{DynamicResource ProgressFontFamily}"
                           FontSize="{DynamicResource ProgressFontSize}"
                           Foreground="{DynamicResource OnHeaderBrush}"
                           ToolTip="Type how many files to copy at once, from 1 to 32, then press Enter. Adaptive turns off. The speed probe does not test this number."/>
                <TextBox x:Name="FilesAtOnceBox" Width="36" MinHeight="0" Padding="4,1" VerticalAlignment="Center"
                         FontFamily="{DynamicResource ProgressFontFamily}"
                         FontSize="{DynamicResource ProgressFontSize}"
                         ToolTip="How many files to copy at once for the rest of this copy. 1 to 32. Press Enter to apply. Turns Adaptive off. Not part of the automatic probe."
                         Text="{Binding DataContext.FilesAtOnceText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}"
                         PreviewKeyDown="FilesAtOnceBox_PreviewKeyDown"/>
            </StackPanel>
            <!-- Types is on its own row: grow through the empty cells under Overall files, not over those stats. -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:StatPairText x:Name="TypesPair"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    ClipToBounds="True"
                                    Margin="0,0,10,2"
                                    DataContext="{Binding Types}"
                                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}"
                                    KeySizeGroup="ProgressStatKey0"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=local:ProgressStatsLine}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
