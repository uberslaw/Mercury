<Window x:Class="Mercury.JobOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mercury"
        x:Name="Root"
        Title="{Binding WindowTitle}"
        Width="920" MinWidth="720" MinHeight="280"
        SizeToContent="Height"
        MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ButtonBrush,ButtonForegroundBrush"
                    Visibility="{Binding ShowAddToQueue, Converter={StaticResource BoolToVis}}">
                <Button Content="Add to queue" Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddToQueueCommand}"/>
            </Border>
            <Button Content="Apply" Style="{StaticResource ToolbarButton}" Command="{Binding ApplyCommand}"/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Command="{Binding CloseCommand}" Margin="0"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
        <local:JobPathsPanel x:Name="DraftPaths"
                             DockPanel.Dock="Top"
                             Margin="0,0,0,12"
                             Visibility="{Binding ShowAddToQueue, Converter={StaticResource BoolToVis}}"
                             SourcePath="{Binding Paths.QueueSourcePath, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             DestPath="{Binding Paths.QueueDestPath, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             DestKindIndex="{Binding Paths.QueueDestKindIndex, ElementName=Root, Mode=TwoWay}"
                             DestIsFolder="{Binding Paths.QueueDestIsFolder, ElementName=Root}"
                             DestIsCatcher="{Binding Paths.QueueDestIsCatcher, ElementName=Root}"
                             HasSourceFolders="{Binding Paths.HasQueueSourceFolders, ElementName=Root}"
                             HasDestFolders="{Binding Paths.HasQueueDestFolders, ElementName=Root}"
                             IncludeSourceFolderName="{Binding IncludeSourceFolderName, Mode=TwoWay}"
                             LandingPreview="{Binding Paths.QueueLandingPreview, ElementName=Root}"
                             ShowLandingPreview="{Binding Paths.ShowQueueLandingPreview, ElementName=Root}"
                             RecentSources="{Binding Paths.RecentSources, ElementName=Root}"
                             RecentDestinations="{Binding Paths.RecentDestinations, ElementName=Root}"
                             SourceFolders="{Binding Paths.QueueSourceFolders, ElementName=Root}"
                             DestFolders="{Binding Paths.QueueDestFolders, ElementName=Root}"
                             CatcherTemplates="{Binding Paths.CatcherTemplates, ElementName=Root}"
                             SelectedCatcherTemplate="{Binding Paths.QueueSelectedCatcherTemplate, ElementName=Root, Mode=TwoWay}"
                             BrowseSourceCommand="{Binding Paths.BrowseQueueSourceCommand, ElementName=Root}"
                             AddSourceCommand="{Binding Paths.AddQueueSourceCommand, ElementName=Root}"
                             ClearSourcesCommand="{Binding Paths.ClearQueueSourcesCommand, ElementName=Root}"
                             RemoveSourceCommand="{Binding Paths.RemoveQueueSourceCommand, ElementName=Root}"
                             BrowseDestCommand="{Binding Paths.BrowseQueueDestCommand, ElementName=Root}"
                             AddDestCommand="{Binding Paths.AddQueueDestCommand, ElementName=Root}"
                             ClearDestsCommand="{Binding Paths.ClearQueueDestsCommand, ElementName=Root}"
                             RemoveDestCommand="{Binding Paths.RemoveQueueDestCommand, ElementName=Root}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <local:JobOptionsPanel/>
        </ScrollViewer>
    </DockPanel>
</Window>
