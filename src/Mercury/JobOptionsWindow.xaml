<Window x:Class="Mercury.JobOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Mercury"
        Title="{Binding WindowTitle}"
        Width="920" MinWidth="720" MinHeight="280"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="ButtonBrush,ButtonForegroundBrush"
                    Visibility="{Binding ShowAddToQueue, Converter={StaticResource BoolToVis}}">
                <Button Content="Add to queue" Style="{StaticResource ToolbarButton}"
                        Command="{Binding AddToQueueCommand}"/>
            </Border>
            <Button Content="Apply" Style="{StaticResource ToolbarButton}" Command="{Binding ApplyCommand}"/>
            <Button Content="Close" Style="{StaticResource AccentButton}" Command="{Binding CloseCommand}" Margin="0"
                    IsDefault="True" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <local:JobOptionsPanel/>
        </ScrollViewer>
    </DockPanel>
</Window>
