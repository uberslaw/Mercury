<UserControl x:Class="Mercury.StatPairText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Mercury"
             Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="KeyColumn" Width="Auto" SharedSizeGroup="ProgressStatKey0"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Shared-size key column: words sit left (sized to glyphs). Empty space before the colon is intentional. -->
        <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Label"
                HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="KeyText"
                           FontFamily="{DynamicResource LabelFontFamily}"
                           FontSize="{DynamicResource LabelFontSize}"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"
                           TextWrapping="NoWrap"
                           Text="{Binding Key, Mode=OneWay}"
                           Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Label">
            <TextBlock x:Name="ColonText"
                       FontFamily="{DynamicResource LabelFontFamily}"
                       FontSize="{DynamicResource LabelFontSize}"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Text=":"
                       Foreground="{DynamicResource MutedBrush}"/>
        </Border>
        <DockPanel Grid.Column="2" x:Name="ValueHost" Margin="8,0,0,0">
            <ToggleButton x:Name="MoreToggle"
                          DockPanel.Dock="Right"
                          Focusable="False"
                          Cursor="Hand"
                          VerticalAlignment="Top"
                          Margin="6,0,0,0"
                          Padding="0"
                          Background="Transparent"
                          BorderThickness="0"
                          Visibility="Collapsed"
                          Click="MoreToggle_Click"
                          ToolTip="Show the rest of the type mix">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MoreLabel"
                               Text="more"
                               FontFamily="{DynamicResource LabelFontFamily}"
                               FontSize="{DynamicResource LabelFontSize}"
                               Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center"/>
                    <Path x:Name="MoreChevron"
                          Data="M 0,1 L 4,5 L 8,1"
                          Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Margin="4,1,0,0"
                          Width="9"
                          Height="7"
                          Stretch="Uniform"
                          VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
            <Border Style="{StaticResource ChromeHighlight}" local:ThemeChrome.Keys="Value">
                <Grid>
                    <TextBlock x:Name="ValueText"
                               FontFamily="{DynamicResource ProgressFontFamily}"
                               FontSize="{DynamicResource ProgressFontSize}"
                               TextAlignment="Left"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <Run x:Name="ValueRun"
                             Text="{Binding Value, Mode=OneWay}"
                             FontFamily="{DynamicResource ValueFontFamily}"
                             FontSize="{DynamicResource ValueFontSize}"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </TextBlock>
                    <ItemsControl x:Name="TypesTable"
                                  Focusable="False"
                                  Visibility="Collapsed"
                                  VerticalAlignment="Top"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Grid.IsSharedSizeScope="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TypeName"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TypeFiles"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TypeSize"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="TypeShare"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Tag="TypeName"
                                               Text="{Binding Label}"
                                               TextAlignment="Left"
                                               HorizontalAlignment="Stretch"
                                               TextWrapping="NoWrap"
                                               FontFamily="{DynamicResource ValueFontFamily}"
                                               FontSize="{DynamicResource ValueFontSize}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock Grid.Column="2"
                                               Tag="TypeFiles"
                                               Text="{Binding Files}"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Stretch"
                                               TextWrapping="NoWrap"
                                               FontFamily="{DynamicResource ValueFontFamily}"
                                               FontSize="{DynamicResource ValueFontSize}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock Grid.Column="4"
                                               Tag="TypeSize"
                                               Text="{Binding Size}"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Stretch"
                                               TextWrapping="NoWrap"
                                               FontFamily="{DynamicResource ValueFontFamily}"
                                               FontSize="{DynamicResource ValueFontSize}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <TextBlock Grid.Column="6"
                                               Tag="TypeShare"
                                               Text="{Binding Share}"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Stretch"
                                               TextWrapping="NoWrap"
                                               FontFamily="{DynamicResource ValueFontFamily}"
                                               FontSize="{DynamicResource ValueFontSize}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
