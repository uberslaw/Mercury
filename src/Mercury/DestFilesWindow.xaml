<Window x:Class="Mercury.DestFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copied files"
        Width="760" Height="560"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource MutedBrush}"
                   Text="Rename a destination file (the name only) and set its last-write time. The file stays inside this job’s destination. Nothing is copied again."/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="File name" VerticalAlignment="Center"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Last part of the path only. Folders and .. are not allowed."/>
                <TextBlock Grid.Row="1" Text="Last write" VerticalAlignment="Center"/>
                <TextBox x:Name="TimeBox" Grid.Row="1" Grid.Column="1"
                         ToolTip="Local last-write time, yyyy-MM-dd HH:mm:ss. Creation time is set to the same instant."/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Style="{StaticResource ToolbarButton}" Click="Apply_Click"/>
                <Button Content="Close" Style="{StaticResource AccentButton}" IsCancel="True" Margin="0"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="FileList" DisplayMemberPath="Display"/>
    </DockPanel>
</Window>
